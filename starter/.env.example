# Local multilingual model; the first run downloads it from Hugging Face.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# Chroma persists vectors and metadata here; no Docker or API key is required.
VECTOR_STORE_PATH=results/chroma

# Only used by the optional PostgreSQL setup checker.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
